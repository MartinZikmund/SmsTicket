<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net11.0-android;net11.0-ios;net11.0-windows10.0.26100;net11.0-browserwasm;net11.0-desktop;net11.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>SmsTicket</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.sphereline.smsticketandroid</ApplicationId>
        <!-- Google Play package names can't change; iOS follows the dev.mzikmund.* convention of the other apps -->
        <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">dev.mzikmund.smsticket</ApplicationId>
        <!-- Package Publisher -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <!-- Package Description -->
        <Description>SmsTicket powered by Uno Platform.</Description>

        <UnoFeatures>
            Mvvm;
            Configuration;
            Hosting;
            Toolkit;
        </UnoFeatures>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) =='android'">24</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- The plain net11.0 target exists for unit tests, which have no native ICU to load -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <SkipIcuDataInitializerGenerator>true</SkipIcuDataInitializerGenerator>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <CompilerVisibleProperty Include="SkipIcuDataInitializerGenerator" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Uno.AdMob" />
    </ItemGroup>

    <!--
      .NET 11 precompiles the whole app into one composite ReadyToRun image on Android (+19 MB per ABI download).
      MAUI apps get partial R2R by default; this opts in the same way: the app assembly and the runtime's
      profiled hot paths stay precompiled, the rest is JIT-ed.
    -->
    <PropertyGroup Condition="'$(IsAndroid)' == 'true'">
        <PublishReadyToRunCrossgen2ExtraArgs>$(PublishReadyToRunCrossgen2ExtraArgs);--partial</PublishReadyToRunCrossgen2ExtraArgs>
    </PropertyGroup>

    <!--
        AdMob iOS app ID. The Google SDK crashes on start without one, so ads stay off when it is empty.
        Debug falls back to Google's sample ID; release builds get the real one from CI (-p:AdMobIosAppId=...).
    -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(AdMobIosAppId)' == '' and '$(Configuration)' == 'Debug'">
        <AdMobIosAppId>ca-app-pub-3940256099942544~1458002511</AdMobIosAppId>
    </PropertyGroup>

    <Target Name="AddAdMobIosAppId" BeforeTargets="_CompileAppManifest" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(AdMobIosAppId)' != ''">
        <PropertyGroup>
            <_AdMobPlist>$(IntermediateOutputPath)AdMob.plist</_AdMobPlist>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(_AdMobPlist)"
            Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;;&lt;plist version=&quot;1.0&quot;&gt;&lt;dict&gt;;&lt;key&gt;GADApplicationIdentifier&lt;/key&gt;&lt;string&gt;$(AdMobIosAppId)&lt;/string&gt;;&lt;/dict&gt;&lt;/plist&gt;"
            Overwrite="true"
            WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <PartialAppManifest Include="$(_AdMobPlist)" />
            <FileWrites Include="$(_AdMobPlist)" />
        </ItemGroup>
    </Target>

    <!-- Single source of truth for ticket data, also served remotely from GitHub (see DataSource) -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\data\tickets.json" Link="Data\tickets.json" LogicalName="SmsTicket.Data.tickets.json" />
    </ItemGroup>

    <!-- SMS User Consent API, for capturing the ticket confirmation SMS -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Xamarin.GooglePlayServices.Auth.Api.Phone" />
    </ItemGroup>

</Project>
