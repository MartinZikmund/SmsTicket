<Page
    x:Class="SmsTicket.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmsTicket"
    xmlns:models="using:SmsTicket.Data.Models"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    NavigationCacheMode="Required">

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Hero  -->
        <Grid x:Name="Hero" Height="260">
            <Image
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind local:MainPage.ToImageSource(ViewModel.SelectedCity.HeroImage), Mode=OneWay}"
                Stretch="UniformToFill" />
            <Border Background="{ThemeResource HeroScrimBrush}" />

            <Button
                x:Name="PhotoInfoButton"
                Width="32"
                Height="32"
                Margin="12"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="PhotoInfoButton"
                AutomationProperties.Name="{x:Bind Localizer.PhotoInfo}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                ToolTipService.ToolTip="{x:Bind Localizer.PhotoInfo}"
                Visibility="{x:Bind local:MainPage.VisibleIfNotNull(ViewModel.SelectedCity.Photo), Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE722;" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel MaxWidth="280" Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind local:MainPage.PhotoAuthorText(ViewModel.SelectedCity.Photo), Mode=OneWay}" TextWrapping="Wrap" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="PhotoLicenseLink"
                                Content="{x:Bind ViewModel.SelectedCity.Photo.License, Mode=OneWay, FallbackValue=''}"
                                NavigateUri="{x:Bind local:MainPage.ToUri(ViewModel.SelectedCity.Photo.LicenseUrl), Mode=OneWay}" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="PhotoSourceLink"
                                Content="{x:Bind Localizer.ViewSource}"
                                NavigateUri="{x:Bind local:MainPage.ToUri(ViewModel.SelectedCity.Photo.SourceUrl), Mode=OneWay}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <StackPanel
                MaxWidth="720"
                Padding="16,0,16,12"
                VerticalAlignment="Bottom"
                Spacing="4">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Localizer.SMSTicket}" />
                <TextBlock
                    AutomationProperties.AutomationId="CityNameText"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectedCity.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="CitySwitcherButton"
                    Margin="0,4,0,0"
                    AutomationProperties.AutomationId="CitySwitcherButton"
                    AutomationProperties.Name="{x:Bind Localizer.ChangeCity}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE707;" />
                        <TextBlock Text="{x:Bind Localizer.ChangeCity}" />
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout
                            x:Name="CityFlyout"
                            Opened="OnCityFlyoutOpened"
                            Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="280" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Localizer.ChooseCity}" />
                                <ListView
                                    x:Name="CityList"
                                    MaxHeight="400"
                                    Margin="-12,0"
                                    AutomationProperties.AutomationId="CityList"
                                    AutomationProperties.Name="{x:Bind Localizer.ChooseCity}"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnCityClick"
                                    ItemsSource="{x:Bind ViewModel.Cities}"
                                    SelectedItem="{x:Bind ViewModel.SelectedCity, Mode=OneWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:City">
                                            <Grid Padding="0,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Height="32"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Abbreviation}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Name}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Ticket picker  -->
        <Grid
            Grid.Row="1"
            MaxWidth="720"
            Padding="16,8,16,0"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Localizer.TicketType}" />
            <ItemsView
                x:Name="TicketsView"
                Grid.Row="1"
                Padding="0,0,0,16"
                AutomationProperties.AutomationId="TicketsView"
                AutomationProperties.Name="{x:Bind Localizer.TicketType}"
                ItemsSource="{x:Bind ViewModel.SelectedCity.TicketTypes, Mode=OneWay}"
                SelectionChanged="OnTicketSelectionChanged"
                SelectionMode="Single">
                <ItemsView.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="3"
                        MinColumnSpacing="8"
                        MinItemHeight="140"
                        MinItemWidth="148"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="models:TicketType">
                        <ItemContainer
                            AutomationProperties.Name="{x:Bind ToString()}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
    <Grid
                            MinHeight="112"
                            Padding="12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind TimeText}"
                                Visibility="{x:Bind local:MainPage.Collapsed(IsDuplicate)}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind IsDuplicate}">
                                <FontIcon FontSize="20" Glyph="&#xE8C8;" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind local:MainPage.DuplicateText}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{x:Bind local:MainPage.PriceText(Price)}" />
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:MainPage.SmsPriceSuffix(SmsPriceAdditional)}" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="3"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasDescription}" />
                        </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
        </Grid>

        <!--  Action bar  -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            utu:SafeArea.Insets="Left,Right"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="688" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    MinHeight="48"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PrepareSmsButton"
                    Command="{x:Bind ViewModel.PrepareForSendCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SendButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Width="48"
                    Height="48"
                    Padding="0"
                    AutomationProperties.AutomationId="PinButton"
                    AutomationProperties.Name="{x:Bind PinLabel(ViewModel.IsPinned), Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePinCommand}"
                    ToolTipService.ToolTip="{x:Bind PinLabel(ViewModel.IsPinned), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPinningSupported, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="{x:Bind local:MainPage.PinGlyph(ViewModel.IsPinned), Mode=OneWay}" />
                </Button>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState" />
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Hero.Height" Value="320" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
