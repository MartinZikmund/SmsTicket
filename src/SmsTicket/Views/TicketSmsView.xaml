<UserControl
    x:Class="SmsTicket.Views.TicketSmsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SmsTicket.Views">

    <StackPanel MaxWidth="440" Spacing="12">
        <InfoBar
            AutomationProperties.AutomationId="TicketSmsInspectionNote"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind InspectionNote}"
            Severity="Warning" />

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Heading}" />
            <TextBlock
                AutomationProperties.AutomationId="TicketSmsValidity"
                Text="{x:Bind Validity}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind Code}"
                Visibility="{x:Bind views:ActiveTicketsStrip.VisibleIfText(Code)}" />
        </StackPanel>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <ScrollViewer MaxHeight="240">
                <TextBlock
                    AutomationProperties.AutomationId="StoredTicketSmsText"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind SmsText}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
