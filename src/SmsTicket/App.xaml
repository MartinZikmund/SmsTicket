<Application
    x:Class="SmsTicket.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localizer="using:SmsTicket.Services.Localizer">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ToolkitResources xmlns="using:Uno.Toolkit.UI" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!--  Fades the hero photo into the page background  -->
                    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.2" Color="#00F3F3F3" />
                        <GradientStop Offset="0.55" Color="#B3F3F3F3" />
                        <GradientStop Offset="0.8" Color="#FFF3F3F3" />
                    </LinearGradientBrush>
                    <!--  Behind the status bar, so its theme-colored icons stay readable on the photo  -->
                    <LinearGradientBrush x:Key="HeroStatusBarScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#CCF3F3F3" />
                        <GradientStop Offset="1" Color="#00F3F3F3" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.2" Color="#00202020" />
                        <GradientStop Offset="0.55" Color="#B3202020" />
                        <GradientStop Offset="0.8" Color="#FF202020" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroStatusBarScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#CC202020" />
                        <GradientStop Offset="1" Color="#00202020" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="HeroScrimBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="HeroStatusBarScrimBrush" ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <localizer:LocalizationService x:Key="Localizer" />

            <!--  Brand accent  -->
            <Color x:Key="SystemAccentColor">#0472D8</Color>
            <Color x:Key="SystemAccentColorLight1">#2B8AE6</Color>
            <Color x:Key="SystemAccentColorLight2">#5AA7F0</Color>
            <Color x:Key="SystemAccentColorLight3">#8EC5F7</Color>
            <Color x:Key="SystemAccentColorDark1">#035FB5</Color>
            <Color x:Key="SystemAccentColorDark2">#024C91</Color>
            <Color x:Key="SystemAccentColorDark3">#01396D</Color>
        </ResourceDictionary>
    </Application.Resources>

</Application>
